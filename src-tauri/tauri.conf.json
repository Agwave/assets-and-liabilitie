{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "个人资产看板",
  "version": "0.1.0",
  "identifier": "com.agwave.assets-ledger",
  "build": {
    "frontendDist": "../out",
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "node scripts/build-desktop.mjs"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "个人资产看板",
        "width": 1100,
        "height": 820,
        "minWidth": 360,
        "minHeight": 480,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
